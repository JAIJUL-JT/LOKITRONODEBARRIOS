# Variables de conexión a la base de datos Supabase (Postgres)
# Opción 1: URL completa
# DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>

# Opción 2: variables individuales (para GitHub Actions/secrets)
# SUPABASE_DB_HOST=
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=
# SUPABASE_DB_USER=
# SUPABASE_DB_PASSWORD=

# Webhook de Make (reemplazar en la función notificar_make o usar secrets)
# MAKE_WEBHOOK_URL=https://hook.eu1.make.com/TU_WEBHOOK_ID
